# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Optional OpenAI BYOK for the LLM. If blank, Agora-managed OpenAI is used.
# This direct provider key is server-side only and is billed by OpenAI.
NEXT_OPENAI_API_KEY=

# Public app origin, reachable by the Agora agent service for the Naranjo tool.
# For local voice testing of that step, use a public HTTPS tunnel URL.
NEXT_PUBLIC_APP_URL=

# WhatsApp invitation profile lookup. Keep these server-side.
# The WhatsApp link carries only a short-lived opaque intake_token.
NEXT_WHATSAPP_PROFILE_API_URL=
NEXT_WHATSAPP_PROFILE_API_KEY=
