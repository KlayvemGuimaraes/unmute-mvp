# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Optional avatar providers. Leave blank to run voice only.
# Recognized values: tavus, liveavatar, generic, auto. LiveAvatar needs an
# explicit 24 kHz TTS pipeline; managed MiniMax does not expose that setting.
NEXT_AGORA_AVATAR_PROVIDER=

# Server-side provider secret. Never use the NEXT_PUBLIC_ prefix.
NEXT_AGORA_AVATAR_API_KEY=

# Required for Generic Avatar; Tavus uses Agora's documented default endpoint.
NEXT_AGORA_AVATAR_BASE_URL=

# Separate provider avatar IDs and Agora RTC UIDs. UIDs must be unique from
# each other, the voice agent UID (123456), and the user's RTC UID.
NEXT_AGORA_CLARA_AVATAR_ID=
NEXT_AGORA_MIGUEL_AVATAR_ID=
NEXT_AGORA_CLARA_UID=
NEXT_AGORA_MIGUEL_UID=
